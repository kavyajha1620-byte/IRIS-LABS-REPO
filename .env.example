# Copy this file to .env.local and fill in your Supabase project credentials.
#
# 1. Go to https://supabase.com and create a free project.
# 2. Open Project Settings > API, copy the Project URL and your key.
#    (Newer projects use a "publishable" key, older ones an "anon" key —
#    use whichever your project dashboard shows.)
# 3. Run the SQL migrations (supabase/migrations/*.sql) in the SQL Editor.
# 4. Enable email/password auth under Authentication > Providers > Email.
# 5. Run the seed file (0002_seed.sql) to create the demo user + sample data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Or use the older anon key name instead of the publishable one:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app (used for email links / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000