# Copy this file to .env.local and fill in your Supabase project credentials.
#
# 1. Go to https://supabase.com and create a free project.
# 2. Open Project Settings > API, copy the Project URL and your key.
#    (Newer projects use a "publishable" key, older ones an "anon" key —
#    use whichever your project dashboard shows.)
# 3. Run the SQL migrations (supabase/migrations/*.sql) in the SQL Editor.
# 4. Enable email/password auth under Authentication > Providers > Email.
# 5. Run the seed file (0002_seed.sql) to create the demo user + sample data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Or use the older anon key name instead of the publishable one:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app (used for email links / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# AI Research & Copilot (optional — app works without these)
# ---------------------------------------------------------------
# Groq key from https://console.groq.com (free tier, OpenAI-compatible).
# Works with any OpenAI-compatible provider via AI_BASE_URL.
AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=qwen/qwen3.8-27b

# Business data for AI Research comes from OpenStreetMap — free, no key,
# no billing account required. No extra configuration needed.

# ---------------------------------------------------------------
# Apify lead generation (optional — app falls back to OpenStreetMap / AI)
# ---------------------------------------------------------------
# Free account at https://console.apify.com. The app NEVER buys credits.
APIFY_API_TOKEN=
# Pick an Actor that returns business listings (e.g. a Google Maps / Places
# scraper). If UNCONFIGURED, generation silently uses OpenStreetMap instead.
APIFY_ACTOR_ID=
# Keep free-mode ON: the app will not purchase credits or start paid runs.
FREE_MODE=true
# Hard cap per generation job (server also enforces a 500 maximum).
MAX_LEADS_PER_JOB=100